<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FastFluentFilesFolders.UserControls.LRSBreadcrumb"
             x:Name="LRSB"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:FastFluentFilesFolders.UserControls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 Unloaded="LRSB_Unloaded"
             mc:Ignorable="d">

	<UserControl.Resources>
		<local:LastToVisibilityConverter x:Key="LastToVisibilityConverter"/>
		<Storyboard x:Key="RotateArrowStoryboard" Duration="0:0:0.2">
			<DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             To="180" Duration="0:0:0.2">
				<DoubleAnimation.EasingFunction>
					<QuadraticEase EasingMode="EaseOut"/>
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>
		</Storyboard>
		<Storyboard x:Key="RotateArrowBackStoryboard" Duration="0:0:0.2">
			<DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             To="0" Duration="0:0:0.2">
				<DoubleAnimation.EasingFunction>
					<QuadraticEase EasingMode="EaseOut"/>
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>
		</Storyboard>
		<x:Double x:Key="CtrlHeight">45</x:Double>
		<x:Double x:Key="CtrlWidth">40</x:Double>
	</UserControl.Resources>
	<Grid ColumnSpacing="0" RowSpacing="20" MinHeight="40">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*"    />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Button Grid.Column="0" x:Name="BackButton"
				Width="{StaticResource CtrlWidth}" Height="{StaticResource LRSBreadcrumbControlsHeight}"
				Command="{x:Bind GoBackCommand, Mode=OneWay}"
				IsEnabled="{x:Bind CanGoBack, Mode=OneWay}"
				Style="{StaticResource SubtleButtonStyle}"
				Padding="4">
			<Viewbox Width="14" Height="14">
				<FontIcon Glyph="&#xE72B;" FontSize="14"/>
			</Viewbox>
		</Button>

		<Button Grid.Column="1" x:Name="ForwardButton"
            Width="{StaticResource CtrlWidth}" Height="{StaticResource LRSBreadcrumbControlsHeight}"
            Command="{x:Bind GoForwardCommand, Mode=OneWay}"
            IsEnabled="{x:Bind CanGoForward, Mode=OneWay}"
            Style="{StaticResource SubtleButtonStyle}"
            Padding="4">
			<Viewbox Width="14" Height="14">
				<FontIcon Glyph="&#xE72A;" FontSize="14"/>
			</Viewbox>
		</Button>

		<Button Grid.Column="2" x:Name="UpButton"
            Width="{StaticResource CtrlWidth}" Height="{StaticResource LRSBreadcrumbControlsHeight}"
            Command="{x:Bind GoUpCommand, Mode=OneWay}"
            Style="{StaticResource SubtleButtonStyle}"
            Padding="4">
			<Viewbox Width="14" Height="14">
				<local:ThemedIcon Style="{StaticResource Icon.Up}"/>
			</Viewbox>
		</Button>

		<Button Grid.Column="3" x:Name="RefreshButton"
				Width="{StaticResource CtrlWidth}" Height="{StaticResource LRSBreadcrumbControlsHeight}"
				Style="{StaticResource SubtleButtonStyle}"
				Click="OnRefreshClick"
				Padding="4">
			<Viewbox Width="14" Height="14">
				<local:ThemedIcon Style="{StaticResource Icon.Refresh}"/>
			</Viewbox>
		</Button>

		<Button Grid.Column="4" x:Name="HomeButton"
				Width="{StaticResource CtrlWidth}" Height="{StaticResource LRSBreadcrumbControlsHeight}"
				Command="{x:Bind NavigateCommand, Mode=OneWay}"
				CommandParameter="{x:Bind HomePath, Mode=OneWay}"
				Style="{StaticResource SubtleButtonStyle}"
				Padding="4">
			<Viewbox Width="14" Height="14">
				<local:ThemedIcon Style="{StaticResource Icon.Home}"/>
			</Viewbox>
		</Button>

		<Border Grid.Column="5" x:Name="AddressBarBorder">
			<Grid x:Name="AddressBarArea" Margin="4,0,0,0" PointerEntered="AddressBarArea_PointerEntered"  PointerPressed="OnAddressBarAreaPointerPressed">
				<TextBox x:Name="PathTextBox"
						 VerticalAlignment="Stretch"
						 Background="Transparent"
						 BorderThickness="0"
						 Visibility="Collapsed"
						 GotFocus="OnPathTextBoxGotFocus"
						 LostFocus="OnPathTextBoxLostFocus"
						 KeyDown="OnPathTextBoxKeyDown"
						 IsReadOnly="True"
						 Text="{x:Bind CurrentPath, Mode=OneWay}"/>

				<TextBox x:Name="SearchTextBox"
				 VerticalAlignment="Stretch"
				 Background="Transparent" BorderThickness="0"
				 Visibility="Collapsed"
				 KeyDown="OnSearchTextBoxKeyDown"
				 Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

				<ScrollViewer x:Name="BreadcrumbScrollViewer"
					  HorizontalScrollBarVisibility="Auto"
					  VerticalScrollBarVisibility="Disabled"
					  IsHitTestVisible="True"
					  Background="Transparent">
					<ItemsControl x:Name="BreadcrumbItemsControl" Margin="10,0,0,0"
						  ItemsSource="{x:Bind Segments, Mode=OneWay}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Horizontal"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="local:BreadcrumbSegment">
								<StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" Margin="0,5,0,5">
									<Button Command="{x:Bind NavigateCommand, Mode=OneWay}"
											CommandParameter="{x:Bind FullPath, Mode=OneWay}"
											Style="{StaticResource SubtleButtonStyle}"
											Content="{x:Bind DisplayName, Mode=OneWay}"
											BorderThickness="0"
											Padding="10,6,10,6"
											VerticalAlignment="Stretch"
											FontSize="13"/>
									<Button x:Name="ChevronButton"
											BorderThickness="0"
											VerticalAlignment="Stretch"
											Style="{StaticResource SubtleButtonStyle}"
											Padding="4,2,4,2"
											FontSize="13"
											Tag="{x:Bind}"
											Click="OnChevronClick"
											Visibility="{x:Bind IsLast, Converter={StaticResource LastToVisibilityConverter}}">
										<Button.RenderTransform>
											<RotateTransform Angle="0"/>
										</Button.RenderTransform>
										<Viewbox Width="10" Height="10">
											<local:ThemedIcon Style="{StaticResource Icon.ChevronRight}"/>
										</Viewbox>
										<Button.Flyout>
											<MenuFlyout Opening="OnFlyoutOpening" Closing="OnFlyoutClosing">
												<MenuFlyout.MenuFlyoutPresenterStyle>
													<Style TargetType="MenuFlyoutPresenter">
														<Setter Property="MaxHeight" Value="400"/>
														<Setter Property="MaxWidth" Value="9999"/>
														<Setter Property="MinWidth" Value="100"/>
													</Style>
												</MenuFlyout.MenuFlyoutPresenterStyle>
											</MenuFlyout>
										</Button.Flyout>
									</Button>
								</StackPanel>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</Grid>
		</Border>

		<Button Grid.Column="6" x:Name="SearchButton"
            Width="{StaticResource CtrlWidth}" Height="{StaticResource LRSBreadcrumbControlsHeight}"
            Style="{StaticResource SubtleButtonStyle}"
            Click="OnSearchButtonClick"
            Padding="4">
			<Viewbox Width="14" Height="14">
				<local:ThemedIcon Style="{StaticResource Icon.Search}"/>
			</Viewbox>
		</Button>

		<Button Grid.Column="7" x:Name="CopyPathButton"
            Width="{StaticResource CtrlWidth}" Height="{StaticResource LRSBreadcrumbControlsHeight}"
			Margin="10,0,0,0"
            Click="OnCopyPathClick"
			Style="{StaticResource SubtleButtonStyle}"
            Padding="4">
			<Viewbox Width="16" Height="16">
				<local:ThemedIcon Style="{StaticResource Icon.Copy}"/>
			</Viewbox>
		</Button>

		<ItemsControl Grid.Column="8" x:Name="PluginToolbarItems" Margin="4,0,0,0">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel Orientation="Horizontal"/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="x:String">
					<Button Width="{StaticResource CtrlWidth}" Height="{StaticResource LRSBreadcrumbControlsHeight}"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="4">
						<Viewbox Width="14" Height="14">
							<local:ThemedIcon Glyph="{x:Bind}" />
						</Viewbox>
					</Button>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
	</Grid>
</UserControl>
