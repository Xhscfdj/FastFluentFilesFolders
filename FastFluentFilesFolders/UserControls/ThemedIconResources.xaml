    <!-- ==================== 图标样式 ==================== -->
    <!-- ThemedIcon 默认配色：线稿跟随正文前景色（含禁用/状态色），强调层取系统强调色 -->
    <Style TargetType="local:ThemedIcon">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Setter Property="AccentBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
    </Style>

    <Style x:Key="Icon.Cut" TargetType="local:ThemedIcon">
        <Setter Property="BaseData" Value="{StaticResource IconData.Cut}"/>
        <Setter Property="AccentOutlineData" Value="{StaticResource IconData.Cut.Outline}"/>
    </Style>

    <Style x:Key="Icon.Copy" TargetType="local:ThemedIcon">
        <Setter Property="AccentFillData" Value="{StaticResource IconData.Copy.Fill}"/>
        <Setter Property="BaseData" Value="{StaticResource IconData.Copy}"/>
        <Setter Property="AccentOutlineData" Value="{StaticResource IconData.Copy.Outline}"/>
    </Style>

    <Style x:Key="Icon.Paste" TargetType="local:ThemedIcon">
        <Setter Property="AccentFillData" Value="{StaticResource IconData.Paste.Fill}"/>
        <Setter Property="BaseData" Value="{StaticResource IconData.Paste}"/>
        <Setter Property="AccentOutlineData" Value="{StaticResource IconData.Paste.Outline}"/>
    </Style>

    <Style x:Key="Icon.Delete" TargetType="local:ThemedIcon">
        <Setter Property="BaseData" Value="{StaticResource IconData.Delete}"/>
        <Setter Property="AccentOutlineData" Value="{StaticResource IconData.Delete.Outline}"/>
    </Style>

    <Style x:Key="Icon.Rename" TargetType="local:ThemedIcon">
        <Setter Property="AccentFillData" Value="{StaticResource IconData.Rename.Fill}"/>
        <Setter Property="BaseData" Value="{StaticResource IconData.Rename}"/>
        <Setter Property="AccentOutlineData" Value="{StaticResource IconData.Rename.Outline}"/>
    </Style>

    <Style x:Key="Icon.Folder" TargetType="local:ThemedIcon">
        <Setter Property="AccentFillData" Value="{StaticResource IconData.Folder.Fill}"/>
        <Setter Property="AccentOutlineData" Value="{StaticResource IconData.Folder.Outline}"/>
    </Style>

    <Style x:Key="Icon.Document" TargetType="local:ThemedIcon">
        <Setter Property="AccentFillData" Value="{StaticResource IconData.Document.Fill}"/>
        <Setter Property="AccentOutlineData" Value="{StaticResource IconData.Document.Outline}"/>
    </Style>

    <Style x:Key="Icon.New" TargetType="local:ThemedIcon">
        <Setter Property="AccentFillData" Value="{StaticResource IconData.New.Fill}"/>
        <Setter Property="BaseData" Value="{StaticResource IconData.New}"/>
        <Setter Property="AccentOutlineData" Value="{StaticResource IconData.New.Outline}"/>
    </Style>

    <Style x:Key="Icon.Sort" TargetType="local:ThemedIcon">
        <Setter Property="BaseData" Value="{StaticResource IconData.Sort}"/>
        <Setter Property="AccentOutlineData" Value="{StaticResource IconData.Sort.Outline}"/>
    </Style>

    <Style x:Key="Icon.Archive" TargetType="local:ThemedIcon">
        <Setter Property="BaseData" Value="{StaticResource IconData.Archive}"/>
        <Setter Property="AccentOutlineData" Value="{StaticResource IconData.Archive.Outline}"/>
    </Style>

    <!-- 打开 / 打开方式 / 还原（Segoe Fluent Icons U+E8E5） -->
    <Style x:Key="Icon.Open" TargetType="local:ThemedIcon">
        <Setter Property="BaseData" Value="{StaticResource IconData.Open}"/>
        <Setter Property="AccentFillData" Value="{StaticResource IconData.Open.Fill}"/>
    </Style>

    <!-- 固定到「快速访问」（Segoe Fluent Icons U+E718） -->
    <Style x:Key="Icon.Pin" TargetType="local:ThemedIcon">
        <Setter Property="BaseData" Value="{StaticResource IconData.Pin}"/>
        <Setter Property="AccentFillData" Value="{StaticResource IconData.Pin.Fill}"/>
    </Style>

    <!-- 从「快速访问」取消固定（Segoe Fluent Icons U+E77A） -->
    <Style x:Key="Icon.Unpin" TargetType="local:ThemedIcon">
        <Setter Property="BaseData" Value="{StaticResource IconData.Unpin}"/>
        <Setter Property="AccentFillData" Value="{StaticResource IconData.Unpin.Fill}"/>
    </Style>

    <!-- 打开文件所在位置 / 文件操作岛（Segoe Fluent Icons U+E8B7） -->
    <Style x:Key="Icon.FolderLine" TargetType="local:ThemedIcon">
        <Setter Property="BaseData" Value="{StaticResource IconData.FolderLine}"/>
        <Setter Property="AccentFillData" Value="{StaticResource IconData.FolderLine.Fill}"/>
    </Style>

    <!-- 属性（Segoe Fluent Icons U+E90F） -->
    <Style x:Key="Icon.Properties" TargetType="local:ThemedIcon">
        <Setter Property="BaseData" Value="{StaticResource IconData.Properties}"/>
        <Setter Property="AccentFillData" Value="{StaticResource IconData.Properties.Fill}"/>
    </Style>

    <!-- 显示更多选项（Segoe Fluent Icons U+E712） -->
    <Style x:Key="Icon.More" TargetType="local:ThemedIcon">
        <Setter Property="BaseData" Value="{StaticResource IconData.More}"/>
    </Style>

    <!-- 彻底删除（Segoe Fluent Icons U+ECC9） -->
    <Style x:Key="Icon.DeletePermanent" TargetType="local:ThemedIcon">
        <Setter Property="BaseData" Value="{StaticResource IconData.DeletePermanent}"/>
        <Setter Property="AccentFillData" Value="{StaticResource IconData.DeletePermanent.Fill}"/>
    </Style>

    <!-- 新建文本文档 / 新建文件（Segoe Fluent Icons U+E7C3） -->
    <Style x:Key="Icon.NewDocument" TargetType="local:ThemedIcon">
        <Setter Property="BaseData" Value="{StaticResource IconData.NewDocument}"/>
        <Setter Property="AccentFillData" Value="{StaticResource IconData.NewDocument.Fill}"/>
    </Style>

    <!-- 新建快捷方式（Segoe Fluent Icons U+E71B） -->
    <Style x:Key="Icon.NewLink" TargetType="local:ThemedIcon">
        <Setter Property="BaseData" Value="{StaticResource IconData.NewLink}"/>
    </Style>

    <!-- 新建 Excel 工作簿（Segoe Fluent Icons U+E9F9） -->
    <Style x:Key="Icon.Excel" TargetType="local:ThemedIcon">
        <Setter Property="BaseData" Value="{StaticResource IconData.Excel}"/>
        <Setter Property="AccentFillData" Value="{StaticResource IconData.Excel.Fill}"/>
    </Style>

    <!-- 新建 Word 文档（Segoe Fluent Icons U+E89A） -->
    <Style x:Key="Icon.Word" TargetType="local:ThemedIcon">
        <Setter Property="BaseData" Value="{StaticResource IconData.Word}"/>
        <Setter Property="AccentFillData" Value="{StaticResource IconData.Word.Fill}"/>
    </Style>

    <!-- 新建 PowerPoint 演示文稿（Segoe Fluent Icons U+E8B4） -->
    <Style x:Key="Icon.PowerPoint" TargetType="local:ThemedIcon">
        <Setter Property="BaseData" Value="{StaticResource IconData.PowerPoint}"/>
        <Setter Property="AccentFillData" Value="{StaticResource IconData.PowerPoint.Fill}"/>
    </Style>

    <!-- 新建文件夹（Segoe Fluent Icons U+E8F4） -->
    <Style x:Key="Icon.NewFolder" TargetType="local:ThemedIcon">
        <Setter Property="BaseData" Value="{StaticResource IconData.NewFolder}"/>
        <Setter Property="AccentFillData" Value="{StaticResource IconData.NewFolder.Fill}"/>
    </Style>

    <!-- 清空回收站 / 删除操作（Segoe Fluent Icons U+E74D） -->
    <Style x:Key="Icon.EmptyRecycleBin" TargetType="local:ThemedIcon">
        <Setter Property="BaseData" Value="{StaticResource IconData.EmptyRecycleBin}"/>
        <Setter Property="AccentFillData" Value="{StaticResource IconData.EmptyRecycleBin.Fill}"/>
    </Style>

    <!-- 后退（Segoe Fluent Icons U+E72B） -->
    <Style x:Key="Icon.Back" TargetType="local:ThemedIcon">
        <Setter Property="BaseData" Value="{StaticResource IconData.Back}"/>
    </Style>

    <!-- 前进（Segoe Fluent Icons U+E72A） -->
    <Style x:Key="Icon.Forward" TargetType="local:ThemedIcon">
        <Setter Property="BaseData" Value="{StaticResource IconData.Forward}"/>
    </Style>

    <!-- 向上一级（Segoe Fluent Icons U+E74A） -->
    <Style x:Key="Icon.Up" TargetType="local:ThemedIcon">
        <Setter Property="BaseData" Value="{StaticResource IconData.Up}"/>
    </Style>

