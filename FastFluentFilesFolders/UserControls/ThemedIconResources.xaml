<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FastFluentFilesFolders.UserControls"
    xmlns:views="using:FastFluentFilesFolders.Views">

    <!-- ==================== 右键菜单（二级命令）项样式 ==================== -->
    <!--
        CommandBarFlyout 的二级命令（Popup 里的列表项）用的不是 AppBarButton 默认模板：
        默认模板里没有 ContentPresenter，所以直接放 Content（ThemedIcon）不会显示（已用红色方块探针验证）。
        这里给菜单项一个自定义模板，把 Content 放进图标位，从而在二级列表里也能用两色 ThemedIcon。
        悬停/按下/禁用状态、快捷键提示、子菜单箭头都在模板里实现。
    -->
    <local:StringToVisibilityConverter x:Key="StringToVisibility"/>
    <views:NullToCollapsedConverter x:Key="NullToVisibility"/>

    <Style x:Key="ThemedMenuItemStyle" TargetType="AppBarButton">
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <!-- 必须显式 Stretch：overflow 会按内容宽度排列菜单项，不拉伸时标签列会被压成一个字宽 -->
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="MinWidth" Value="160"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="AppBarButton">
                    <Grid x:Name="Root" Background="Transparent" MinHeight="32">
                        <Border x:Name="Highlight" Background="Transparent" CornerRadius="4" Margin="4,2" Opacity="0"/>
                        <Grid Padding="16,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ContentPresenter Grid.Column="0"
                                              Content="{TemplateBinding Content}"
                                              VerticalAlignment="Center"/>

                            <TextBlock x:Name="LabelText" Grid.Column="1"
                                       Text="{TemplateBinding Label}"
                                       Foreground="{TemplateBinding Foreground}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>

                            <TextBlock x:Name="AccelText" Grid.Column="2"
                                       Text="{TemplateBinding KeyboardAcceleratorTextOverride}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding KeyboardAcceleratorTextOverride, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StringToVisibility}}"/>

                            <FontIcon x:Name="Chevron" Grid.Column="3"
                                      Glyph="&#xE76C;"
                                      FontSize="12"
                                      Margin="10,0,0,0"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Visibility="{Binding Flyout, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToVisibility}}"/>
                        </Grid>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Highlight" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Highlight.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Highlight" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Highlight.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Highlight" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.06"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ThemedIcon 图标库。
        上半部分是几何数据（IconData.*，SVG 路径微语言，16×16 设计栅格）：
          · 不带后缀 = 线稿层（BaseData，用 Foreground 绘制）
          · .Fill     = 内部色域层（AccentFillData，用 AccentBrush 以 40% 透明度填充）
          · .Outline  = 强调色描边层（AccentOutlineData）
        下半部分是样式（Icon.*），供 <local:ThemedIcon Style="{StaticResource Icon.Xxx}"/> 使用；
        动态字形（插件/文件操作岛）通过 FastFluentFilesFolders.UserControls.ThemedIconGlyphs 按字形码位查找同一份数据。
        菜单/工具栏图标由 Segoe Fluent Icons 字形轮廓矢量化而来，与系统字体渲染形状一致。
    -->

