<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FastFluentFilesFolders.Views.FileTreeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FastFluentFilesFolders.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FastFluentFilesFolders.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Icon 为空时显示节点字形（此电脑/网络/回收站等），图标加载出来后又切回真实图标 -->
        <local:NullToVisibleConverter x:Key="NullToVisible" />
        <local:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <!-- 增高侧栏每一项（默认 28） -->
        <x:Double x:Key="TreeViewItemMinHeight">40</x:Double>
    </Page.Resources>

    <Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Border Grid.Row="0" 
            Height="1" 
            Background="Gray" 
            Margin="10,5,10,5" />
		<TreeView x:Name="SidebarTree"
				  Grid.Row="1"
                  ItemsSource="{Binding RootDirectories}"
                  SelectionChanged="TreeView_SelectionChanged"
                  KeyDown="TreeView_KeyDown"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollMode="Disabled">
            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="vm:FileSystemNodeViewModel">
                    <TreeViewItem ItemsSource="{Binding Children}"
                                  IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                  IsSelected="{Binding IsSelected, Mode=TwoWay}">
                        <TreeViewItem.Content>
                            <StackPanel Orientation="Horizontal" Opacity="{Binding RowOpacity, Mode=OneWay}">
                                <Grid Width="20" Height="20" VerticalAlignment="Center">
                                    <Image Source="{Binding Icon}"
                                           Width="20" Height="20"
                                           Visibility="{Binding Icon, Converter={StaticResource NullToCollapsed}}"/>
                                    <FontIcon Glyph="{Binding IconGlyph}"
                                              FontSize="14"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Visibility="{Binding Icon, Converter={StaticResource NullToVisible}}"/>
                                </Grid>
                                <TextBlock Text="{Binding Name}" Margin="5,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </TreeViewItem.Content>
                    </TreeViewItem>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</Page>
