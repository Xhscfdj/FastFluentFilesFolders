<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="FastFluentFilesFolders.Views.UpdateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
	CloseButtonStyle="{StaticResource ResourceKey=DialogButtonStyle}" 
    SecondaryButtonClick="OnSecondaryButtonClick"
    Closing="OnDialogClosing">

	<StackPanel Width="420" Spacing="14">
        <!-- 版本对比 -->
		<Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="2">
                <TextBlock x:Name="CurrentVersionCaption"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="CurrentVersionText"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock x:Name="LatestVersionCaption"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="LatestVersionText"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- 状态：转圈 + 文案 -->
        <StackPanel Orientation="Horizontal" Spacing="10">
            <ProgressRing x:Name="BusyRing" Width="18" Height="18"
                          IsActive="False" Visibility="Collapsed"
                          VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 更新内容 -->
        <StackPanel x:Name="ReleaseNotesPanel" Spacing="6" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="ReleaseNotesCaption" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="PublishDateText"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <ScrollViewer MaxHeight="180" Padding="12,8" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="ReleaseNotesText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <HyperlinkButton x:Name="ReleaseNotesLinkButton" Padding="0" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- 下载进度 -->
        <StackPanel x:Name="DownloadPanel" Spacing="6" Visibility="Collapsed">
            <ProgressBar x:Name="DownloadBar" Minimum="0" Maximum="100" Value="0" />
            <TextBlock x:Name="DownloadText"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- 出错提示 -->
        <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="False" />
    </StackPanel>
</ContentDialog>
